{
  "name": "kmitl-room-booking",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs deployment .github *.md *.json *.ts",
    "format:check": "prettier --check src tests docs deployment .github *.md *.json *.ts",
    "test:deployment": "node --test deployment/static-server.test.mjs",
    "deploy:local": "npm run build && node deployment/install-local.mjs",
    "serve:deployment": "node deployment/static-server.mjs",
    "smoke:deployment": "node deployment/smoke-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
